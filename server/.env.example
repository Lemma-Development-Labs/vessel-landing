# Railway service env. Never commit real values.
DATABASE_URL=postgresql://user:pass@host:5432/railway
RESEND_API_KEY=
RESEND_FROM=Vessel <crew@mail.vessel.wtf>
ADMIN_KEY=
PORT=8080
CORS_ORIGINS=https://vessel.wtf,https://www.vessel.wtf,https://testnet.vessel.wtf,http://localhost:3000

# Optional. Salts the stored ip_hash so hashes are not reversible by
# brute-forcing the (small) IPv4 space. Set to any long random string.
IP_HASH_SALT=
